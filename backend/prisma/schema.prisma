generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model User {
  id           String    @id @default(uuid())
  name         String?
  email        String?   @unique
  phone        String?   @unique
  passwordHash String?   // null for phone/OTP-only accounts
  referralCode String?   @unique
  referredById String?
  points       Int       @default(0)
  createdAt    DateTime  @default(now())

  resumes      Resume[]
  applications JobApplication[]
  subscription Subscription?
}

// A unique record prevents more than one reward for the same new account.
model ReferralReward {
  id             String   @id @default(uuid())
  referrerId     String
  referredUserId String   @unique
  pointsAwarded  Int      @default(500)
  createdAt      DateTime @default(now())

  @@index([referrerId])
}

model Subscription {
  id                     String             @id @default(uuid())
  user                   User               @relation(fields: [userId], references: [id])
  userId                 String             @unique
  plan                   String             @default("ANNUAL_499") // ₹499 / year plan
  status                 SubscriptionStatus @default(TRIAL)
  razorpayCustomerId     String?
  razorpaySubscriptionId String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  trialEndsAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
}

// Short-lived OTP codes for phone login. Rows are deleted/expired after use.
model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}

model Resume {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  title      String   @default("Untitled Resume")
  template   String   @default("modern") // "modern" | "classic"
  content    Json     // { personalInfo, summary, experience[], education[], skills[], projects[] }
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEWING
  OFFER
  REJECTED
}

model JobApplication {
  id                String            @id @default(uuid())
  user              User              @relation(fields: [userId], references: [id])
  userId            String
  company           String
  role              String
  location          String?
  applicationUrl    String?
  notes             String?
  status            ApplicationStatus @default(SAVED)
  submittedResumeId String?
  appliedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([userId, status])
}
